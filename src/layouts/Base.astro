---
// Shared <head> for public pages. Carries the full SEO/GEO layer from the
// approved seo-plan: canonical, robots, Open Graph, hreflang, JSON-LD.
// Identity (author / publisher / sameAs) comes from lib/site.ts.
import { SITE, SITE_NAME, personLd, organizationLd } from '../lib/site';
import '../styles/main.css';

export interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  bodyClass?: string;
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string;
  // Page-level JSON-LD objects (already carrying @context) rendered in <head>.
  jsonLd?: Record<string, unknown>[];
}
const {
  title = 'BarabashFlow — tworzenie stron internetowych i platform',
  description = 'Studio Dmytrija Barabasha z Warszawy: tworzenie stron internetowych, sklepów, platform i aplikacji webowych dla firm. Kod na miarę, własny CMS, wycena w 24 h.',
  noindex = false,
  bodyClass = '',
  ogType = 'website',
  ogImage = `${SITE}/assets/img/og.png`,
  jsonLd = [],
} = Astro.props;

const site = SITE;
const canonical = new URL(Astro.url.pathname, site).href;

// Person + Organization/ProfessionalService + WebSite as one graph, so the
// author entity is the same @id on every page (home, blog posts, about).
const siteGraphLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personLd,
    { ...organizationLd, description },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      name: SITE_NAME,
      url: site,
      inLanguage: ['pl', 'en', 'ru'],
      publisher: { '@id': organizationLd['@id'] },
    },
  ],
};
---
<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex
    ? <meta name="robots" content="noindex,nofollow" />
    : <>
        <meta name="robots" content="index,follow" />
        <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
      </>}

  <meta name="theme-color" content="#f3f4f6" />
  <meta name="color-scheme" content="light" />

  <link rel="icon" type="image/png" href="/assets/img/logo.png" />
  <link rel="apple-touch-icon" href="/assets/img/logo.png" />

  <!-- hreflang: single-URL strategy (Variant A) — PL indexed, EN/RU same URL. -->
  <link rel="alternate" hreflang="pl" href={canonical} />
  <link rel="alternate" hreflang="en" href={canonical} />
  <link rel="alternate" hreflang="ru" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="BarabashFlow" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:locale:alternate" content="en_US" />
  <meta property="og:locale:alternate" content="ru_RU" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://yhtzxkhfqzuaafvappln.supabase.co" crossorigin />
  <link rel="preload" href="/assets/fonts/Sunsive-Bold.woff2" as="font" type="font/woff2" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  {!noindex && <>
    <script type="application/ld+json" set:html={JSON.stringify(siteGraphLd)} />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </>}

  <!-- Anti-FOUC: apply saved locale before first paint. -->
  <script is:inline>
    (function () {
      try {
        var l = localStorage.getItem('bf:locale');
        if (l === 'pl' || l === 'en' || l === 'ru') document.documentElement.lang = l;
      } catch (e) {}
    })();
  </script>
</head>
<body class={bodyClass}>
  <slot />
</body>
</html>
