---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BlogCard from '../../components/BlogCard.astro';
import { fetchPostList } from '../../lib/blog';
import { fetchSettings, fetchServices } from '../../lib/content';
import { SITE, PERSON_ID, ORG_ID } from '../../lib/site';

const [posts, settings, services] = await Promise.all([fetchPostList(), fetchSettings(), fetchServices()]);
const title = 'Blog — BarabashFlow | strony internetowe, platformy, SEO';
const description = 'Blog studia BarabashFlow: praktycznie o stronach internetowych, platformach, sklepach online i SEO dla firm. Ceny, technologie, porady — bez żargonu.';
const blogLd = { '@context': 'https://schema.org', '@type': 'Blog', '@id': `${SITE}/blog/#blog`, name: 'Blog BarabashFlow', url: `${SITE}/blog/`, description, inLanguage: 'pl', publisher: { '@id': ORG_ID }, author: { '@id': PERSON_ID } };
---
<Base title={title} description={description} jsonLd={[blogLd]}>
  <SiteHeader active="blog" />
  <main class="container">
    <section class="sec">
      <div class="sec-inner page-head">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">BarabashFlow</a><span>/</span><span>Blog</span></nav>
        <span class="kicker" data-i18n="blog.chip">Strony · Platformy · SEO</span>
        <h1 data-i18n="blog.h1">Blog o stronach internetowych, platformach i SEO</h1>
        <p class="lead" data-i18n="blog.sub">Praktycznie o stronach internetowych, platformach i widoczności w Google — ceny, technologie i porady dla firm, bez żargonu.</p>
        <p class="post-byline"><span data-i18n="blog.by">Autor</span>: <a href="/o-mnie/" rel="author">Damian Barabash</a> · {posts.length} wpisów</p>
      </div>
    </section>
    <div class="divider" aria-hidden="true"></div>
    <section class="sec">
      <div class="sec-inner is-grey sec-pad">
        {posts.length === 0 && <p class="lead" data-i18n="blog.empty">Pierwsze wpisy są w drodze — zajrzyj tu wkrótce.</p>}
        <div class="blog-grid">
          {posts.map((p, i) => <BlogCard p={p} eager={i < 3} />)}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter services={services} settings={settings} />
  <script>
    import { mountShell } from '../../lib/shell';
    mountShell();
  </script>
</Base>
