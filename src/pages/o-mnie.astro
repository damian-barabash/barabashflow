---
// Author / about page — the E-E-A-T anchor: who writes the blog and builds
// the projects, how they work, editorial policy for the blog, public profiles.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { mediaUrl } from '../lib/supabase';
import { fetchSettings, fetchServices, fetchProjects, s, lm, lmRow } from '../lib/content';
import { SITE, AUTHOR_NAME, EMAIL, PERSON_ID, SOCIAL } from '../lib/site';

const [settings, services, projects] = await Promise.all([fetchSettings(), fetchServices(), fetchProjects()]);
const title = 'O mnie — Dmytrii Barabash, web developer | BarabashFlow';
const description = 'Dmytrii Barabash — web developer z Warszawy, założyciel BarabashFlow. Strony, sklepy, platformy i aplikacje webowe dla firm: jak pracuję, technologie, zasady bloga.';
const STACK = ['Astro', 'React', 'Next.js', 'TypeScript', 'Supabase', 'PostgreSQL', 'Three.js', 'Flutter', 'WooCommerce', 'GitHub Pages', 'Cloudflare'];
const ownerPhoto = mediaUrl(settings.owner_photo_path?.value_meta?.path);
const profileLd = { '@context': 'https://schema.org', '@type': 'ProfilePage', '@id': `${SITE}/o-mnie/#profile`, url: `${SITE}/o-mnie/`, name: title, description, inLanguage: 'pl', mainEntity: { '@id': PERSON_ID } };
const crumbsLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'BarabashFlow', item: SITE + '/' },
  { '@type': 'ListItem', position: 2, name: 'O mnie', item: SITE + '/o-mnie/' },
] };
---
<Base title={title} description={description} ogType="profile" jsonLd={[profileLd, crumbsLd]}>
  <SiteHeader active="about" />
  <main class="container">
    <section class="sec">
      <div class="sec-inner page-head">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">BarabashFlow</a><span>/</span><span data-i18n="nav.about">O mnie</span></nav>
        <span class="kicker" data-i18n="about.kicker">O mnie</span>
        <h1 data-i18n="about.title">Dmytrii Barabash — web developer i założyciel BarabashFlow</h1>
        <p class="lead" data-i18n="about.lead">Projektuję i buduję strony internetowe, sklepy, platformy i aplikacje webowe dla firm. Pracuję z Warszawy, dla klientów z Polski i zagranicy — po polsku, angielsku i rosyjsku.</p>
      </div>
    </section>
    <div class="divider" aria-hidden="true"></div>
    <section class="sec">
      <div class="sec-inner sec-pad">
        <div class="about-grid" style="margin-bottom: clamp(32px,5vw,64px)">
          <div class="about-media tile-pattern">
            {ownerPhoto ? <img src={ownerPhoto} alt={AUTHOR_NAME} loading="eager" /> : <><span class="tp-label">{AUTHOR_NAME}</span><span class="tp-num">BF</span></>}
          </div>
          <div class="prose" style="margin:0">
            <h2 style="margin-top:0" {...lm(settings, 'about_title')}>{s(settings, 'about_title')}</h2>
            <p {...lm(settings, 'about_text')}>{s(settings, 'about_text')}</p>
            <h3 data-i18n="about.h.stack">Technologie</h3>
            <div class="stack-chips">{STACK.map((x) => <span class="chip">{x}</span>)}</div>
            <p>{SOCIAL.map((so) => <a href={so.url} rel="me noopener" target="_blank">{so.label} ↗</a>)} · <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
          </div>
        </div>
        <div class="prose">
          <h2 data-i18n="about.h.what">Czym się zajmuję</h2>
          <p data-i18n="about.p.what">Całym procesem — od briefu i wyceny, przez projekt graficzny i kod, po wdrożenie na domenie i opiekę po starcie. Nie używam gotowych szablonów: każdy projekt to kod pisany pod konkretną firmę, jej klientów i cele.</p>
          <p>{services.map((sv, i) => <><a href={`/uslugi/${sv.slug}/`} {...lmRow(sv, 'title')}>{sv.title_pl}</a>{i < services.length - 1 ? ' · ' : ''}</>)}</p>

          <h2 data-i18n="about.h.how">Jak pracuję</h2>
          <p data-i18n="about.p.how">Szybko i przejrzyście. Na brief odpowiadam w 24 godziny z planem i konkretną wyceną. Postęp widzisz na żywo i zgłaszasz uwagi na bieżąco. Strony buduję jako statyczne (Astro, React, Next.js) z backendem Supabase — ładują się natychmiast i dobrze pozycjonują w Google.</p>

          <h2 data-i18n="about.projects">Zrealizowane projekty</h2>
          <ul>{projects.map((p) => <li><a href={`/projekty/${p.slug}/`}>{p.title_pl}</a>{p.client && p.client !== p.title_pl ? ` — ${p.client}` : ''}</li>)}</ul>

          <h2 data-i18n="about.h.editorial">Zasady redakcyjne bloga</h2>
          <p data-i18n="about.p.editorial">Wpisy na blogu odpowiadają na realne pytania, które klienci zadają przed zleceniem strony — tematy wybieram na podstawie wyszukiwań w Google i rozmów z klientami. Nie wymyślam statystyk ani opinii klientów, podaję realne widełki cenowe, a starsze artykuły aktualizuję, gdy zmieniają się ceny lub technologie (data aktualizacji jest widoczna przy każdym wpisie). Blog nie zawiera reklam ani linków afiliacyjnych. Zdjęcia pochodzą z bibliotek na licencjach Creative Commons, z podaniem autora.</p>
          <p><a href="/blog/" data-i18n="blog.h1">Blog o stronach internetowych, platformach i SEO</a></p>

          <h2 data-i18n="about.h.contact">Kontakt</h2>
          <p data-i18n="about.p.contact">Najszybciej przez formularz lub e-mail. Odpowiadam w ciągu 24 godzin w dni robocze.</p>
          <div class="page-actions">
            <a class="btn btn-dark" href="/kontakt/" data-i18n="about.cta">Napisz do mnie</a>
            <a class="btn btn-white" href="/polityka-prywatnosci/" data-i18n="nav.privacy">Polityka prywatności</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter services={services} settings={settings} />
  <script>
    import { mountShell } from '../lib/shell';
    mountShell();
  </script>
</Base>
