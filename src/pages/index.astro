---
// Home — hero with the 3D mark, trusted strip, studio + stats, services,
// approach, featured projects, process, marquee, why-us, blog, FAQ; the CTA
// band + contact + footer come from SiteFooter. All CMS content is baked in
// at build (PL in markup, EN/RU in data-lm-* attributes).
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProjectReel from '../components/ProjectReel.astro';
import FaqList from '../components/FaqList.astro';
import BlogCard from '../components/BlogCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { mediaUrl } from '../lib/supabase';
import { fetchSettings, fetchServices, fetchProjects, fetchFaq, s, lm, lmRow, projectCover, categoryLm, firstSentence, type Project } from '../lib/content';
import { restGet } from '../lib/supabase';
import { SITE, AUTHOR_NAME, SITE_PUBLISHED, SOURCES } from '../lib/site';
import { formatDatePl, type BlogPost } from '../lib/blog';

const [settings, services, projects, faq, posts] = await Promise.all([
  fetchSettings(), fetchServices(), fetchProjects(), fetchFaq('home'),
  restGet<BlogPost>('blog_posts?select=slug,title_pl,title_en,title_ru,excerpt_pl,excerpt_en,excerpt_ru,cover_path,cover_alt,published_at,tags&status=eq.published&order=published_at.desc&limit=3'),
]);
const reelProjects = projects.slice(0, 10);
const featured = (projects.filter((p) => p.is_featured).length ? projects.filter((p) => p.is_featured) : projects).slice(0, 4);
const trusted = projects.map((p) => ({ name: p.client || p.title_pl, slug: p.slug })).filter((x, i, a) => a.findIndex((y) => y.name === x.name) === i && !/barabash/i.test(x.name)).slice(0, 6);
const stats: any[] = settings.home_stats?.value_meta?.items || [];
const ownerPhoto = mediaUrl(settings.owner_photo_path?.value_meta?.path);
const visionImg = projectCover(featured[0]);
// Hero case (audit 2026-11-10): one real client task next to the H1. Picked in
// admin → Strona (site_settings.hero_case); fallback = first featured with a task.
const heroCaseSlug = settings.hero_case?.value_meta?.slug;
const heroCase = projects.find((p) => p.slug === heroCaseSlug && p.challenge_pl) || featured.find((p) => p.challenge_pl) || projects.find((p) => p.challenge_pl);
const heroCaseThumb = heroCase ? projectCover(heroCase) : null;

const title = 'Strony, sklepy i platformy — Warszawa | BarabashFlow';
const description = 'BarabashFlow, Warszawa: tworzenie stron internetowych, sklepów i platform na zamówienie. Kod na miarę, własny CMS, wycena projektu w 24 h — bez szablonów.';
const heroSub = s(settings, 'hero_subtitle', 'pl', 'Kod na miarę, własny panel CMS i wycena projektu w 24 h.');
const heroSubShort = { pl: firstSentence(heroSub) || heroSub, en: firstSentence(s(settings, 'hero_subtitle', 'en')) || heroSub, ru: firstSentence(s(settings, 'hero_subtitle', 'ru')) || heroSub };
const BUILT = new Date().toISOString().slice(0, 10);
const priceLine = services.filter((sv) => sv.price_from).slice(0, 3);
const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE}/#webpage`,
  url: `${SITE}/`,
  name: title,
  description,
  inLanguage: 'pl',
  datePublished: SITE_PUBLISHED,
  dateModified: BUILT,
  author: { '@id': `${SITE}/#person` },
  publisher: { '@id': `${SITE}/#organization` },
  isPartOf: { '@id': `${SITE}/#website` },
};

const faqLd = faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.question_pl, acceptedAnswer: { '@type': 'Answer', text: f.answer_pl } })),
} : null;
const servicesLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Usługi BarabashFlow',
  itemListElement: services.map((sv, i) => ({ '@type': 'ListItem', position: i + 1, name: sv.title_pl, url: `${SITE}/uslugi/${sv.slug}/` })),
};
const ICONS: Record<string, string> = {
  site: '<path d="M3 5h18v14H3z"/><path d="M3 9h18M7 7h.01M10 7h.01"/>',
  shop: '<path d="M4 7h16l-1 13H5z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/>',
  platform: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  care: '<path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z"/>',
};
// Hero "live" widget: covers of the newest/strongest works, cycled in a mini browser.
const liveShots = projects
  .filter((p) => p.cover_path && p.url)
  .slice(0, 7)
  .map((p) => ({ src: mediaUrl(p.cover_path!)!, host: new URL(p.url!).host.replace(/^www\./, '') }));
// Showreel: rendered only when the video files are in public/assets/video/.
const hasReel = fs.existsSync('public/assets/video/showreel-1080.mp4');
const hasReelV = fs.existsSync('public/assets/video/showreel-9x16-720.mp4');
const YEAR = new Date().getFullYear();
const tagOf = (p: Project) => ({
  pl: p.tagline_pl || firstSentence(p.description_pl),
  en: p.tagline_en || firstSentence(p.description_en) || p.tagline_pl || firstSentence(p.description_pl),
  ru: p.tagline_ru || firstSentence(p.description_ru) || p.tagline_pl || firstSentence(p.description_pl),
});
---
<Base title={title} description={description} jsonLd={[webPageLd, servicesLd, ...(faqLd ? [faqLd] : [])]} bodyClass="is-home" modified={BUILT}>
  <SiteHeader active="home" />

  <main>
    <div class="container">
      <!-- ── HERO ─────────────────────────────────────────────────────── -->
      <section class="sec">
        <div class="hero">
          <div class="hero-inner">
            <div class="arrow-track is-left" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 4h3l6 8-6 8H6l6-8z"/></svg><svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 4h3l6 8-6 8H6l6-8z"/></svg><svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 4h3l6 8-6 8H6l6-8z"/></svg>
            </div>
            <div class="arrow-track is-right" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M18 4h-3l-6 8 6 8h3l-6-8z"/></svg><svg viewBox="0 0 24 24"><path fill="currentColor" d="M18 4h-3l-6 8 6 8h3l-6-8z"/></svg><svg viewBox="0 0 24 24"><path fill="currentColor" d="M18 4h-3l-6 8 6 8h3l-6-8z"/></svg>
            </div>

            <div class="hero-copy">
              <h1 class="hero-h1" {...lm(settings, 'hero_title')}>{s(settings, 'hero_title', 'pl', 'Strony internetowe, sklepy i platformy na zamówienie — Warszawa')}</h1>
              <p class="hero-sub" data-lm-pl={heroSubShort.pl} data-lm-en={heroSubShort.en} data-lm-ru={heroSubShort.ru}>{heroSubShort.pl}</p>
              <div class="hero-actions">
                <a class="btn btn-dark with-icon" href="#contact">
                  <span class="btn-ico"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M13 3H6M13 3v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  <span data-i18n="hero.cta">Wyceń projekt</span>
                </a>
                <a class="btn btn-white" href="/projekty/" data-i18n="hero.work">Zobacz realizacje</a>
              </div>
              {heroCase && (
                <a class="hero-case" href={`/projekty/${heroCase.slug}/`}>
                  {heroCaseThumb && <img src={heroCaseThumb} alt="" width="120" height="75" loading="eager" decoding="async" />}
                  <span class="hc-body">
                    <span class="hc-k"><span data-i18n="projects.task">Zadanie klienta</span> · {heroCase.client || heroCase.title_pl}</span>
                    <span class="hc-t" {...lmRow(heroCase, 'challenge')}>{heroCase.challenge_pl}</span>
                    <span class="hc-more"><span data-i18n="hero.case.more">Zobacz, jak to rozwiązałem</span> <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 11 11 3M11 3H5M11 3v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  </span>
                </a>
              )}
            </div>
            <div class="hero-visual" aria-hidden="true">
              <span class="hero-word" {...lm(settings, 'hero_word_a')}>{s(settings, 'hero_word_a', 'pl', 'TWORZYMY')}</span>
              <div class="hero-logo-card">
                <div id="hero-logo" aria-label="Logo 3D BarabashFlow — przeciągnij, aby obrócić">
                  <div class="hero-logo-fallback"><img src="/assets/img/logo.png" alt="" width="326" height="402" /></div>
                </div>
              </div>
              <span class="hero-word" {...lm(settings, 'hero_word_b')}>{s(settings, 'hero_word_b', 'pl', 'STRONY')}</span>
              <div class="hw hw-live" style="--d:1">
                <div class="hw-bar"><i></i><i></i><i></i><span class="hw-url">{liveShots[0]?.host}</span><em class="hw-dot" data-i18n="hw.live">live</em></div>
                <div class="hw-shots">{liveShots.map((ls, i) => <img src={i === 0 ? ls.src : undefined} data-src={ls.src} data-host={ls.host} alt="" class={i === 0 ? 'is-on' : ''} width="320" height="200" decoding="async" />)}</div>
              </div>
              <div class="hw hw-lead" style="--d:2">
                <span class="hw-av"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg></span>
                <div><b data-i18n="hw.lead">Nowe zapytanie</b><span class="hw-ref">BF-<em>28417</em> · <span data-i18n="hw.now">teraz</span></span></div>
              </div>
          </div>
        </div>
      </section>

      <section class="sec">
        <a class="cta-bar" href="#contact">
          <span {...lm(settings, 'cta_label', 'Wycena w 24 h')}>{s(settings, 'cta_label', 'pl', 'Wycena w 24 h')}</span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M18 6H8M18 6v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </section>

      <!-- ── SHOWREEL (autoplay, muted, right after the hero) ──────────── -->
      {hasReel && (
        <section class="sec reel-sec" id="showreel" aria-label="Showreel BarabashFlow">
          <div class="reel-inline">
            <video class="ri-video" muted loop playsinline preload="none" poster="/assets/video/poster.jpg"
              data-hd="/assets/video/showreel-1080.mp4" data-sd="/assets/video/showreel-720.mp4"
              data-v={hasReelV ? '/assets/video/showreel-9x16-720.mp4' : undefined} data-v-poster={hasReelV ? '/assets/video/poster-9x16.jpg' : undefined}></video>
            <div class="ri-actions">
              <button class="ri-btn" type="button" data-ri-sound aria-pressed="false"><svg class="i-off" viewBox="0 0 20 20" fill="none"><path d="M4 8h3l4-3v10l-4-3H4z" fill="currentColor"/><path d="m14 8 4 4m0-4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><svg class="i-on" viewBox="0 0 20 20" fill="none"><path d="M4 8h3l4-3v10l-4-3H4z" fill="currentColor"/><path d="M14 7.5a3.5 3.5 0 0 1 0 5M16 5.5a6.5 6.5 0 0 1 0 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span data-i18n="reel.sound">Dźwięk</span></button>
              <button class="ri-btn" type="button" data-reel><svg viewBox="0 0 20 20" fill="none"><path d="M4 8V4h4M16 8V4h-4M4 12v4h4M16 12v4h-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span data-i18n="reel.full">Pełny ekran</span></button>
            </div>
          </div>
        </section>
      )}

      <!-- trusted strip -->
      {trusted.length > 0 && (
        <section class="sec">
          <div class="sec-inner trusted">
            <span class="label"><span data-i18n="home.trusted">Zaufali mi</span></span>
            {trusted.map((t) => <a class="name" href={`/projekty/${t.slug}/`}>{t.name}</a>)}
          </div>
        </section>
      )}
      <div class="divider" aria-hidden="true"></div>

      <!-- ── STUDIO + STATS ───────────────────────────────────────────── -->
      <section class="sec" id="o-studiu">
        <div class="sec-inner sec-pad">
          <div class="sec-head">
            <span class="kicker" data-i18n="home.about.kicker">O studiu</span>
            <h2 class="h-sec" {...lm(settings, 'about_title')}>{s(settings, 'about_title')}</h2>
          </div>
          <div class="about-grid">
            <div>
              <ul class="stats">
                {stats.map((st, i) => {
                  const isAuto = st.auto === 'projects';
                  const num = isAuto ? String(projects.length) : String(st.value);
                  const numeric = /^\d+(\.\d+)?$/.test(num);
                  const suffix = st.suffix || '';
                  return (
                    <li class="stat">
                      <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={[ICONS.site, ICONS.platform, '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>', ICONS.care][i % 4]} /></span>
                      <div>
                        <div class="num">{numeric ? <span data-count={num} data-suffix={suffix} data-final={num + suffix}>{num + suffix}</span> : num + suffix}</div>
                        <div class="lbl" {...lmRow(st, 'label')}>{st.label_pl}</div>
                      </div>
                    </li>
                  );
                })}
              </ul>
              <p class="about-text" {...lm(settings, 'about_text')}>{s(settings, 'about_text')}</p>
              <div class="about-cta">
                <a class="btn btn-ghost" href="/o-mnie/"><span data-i18n="about.kicker">O mnie</span><svg class="btn-arrow" viewBox="0 0 14 14" fill="none"><path d="M3 11 11 3M11 3H5M11 3v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
              </div>
            </div>
            <div class="about-media tile-pattern" data-reveal>
              {ownerPhoto ? <img src={ownerPhoto} alt={s(settings, 'owner_name', 'pl', AUTHOR_NAME)} loading="lazy" /> : (
                <div class="dot-tile" data-dots="logo|BF|</>">
                  <canvas></canvas>
                  <span class="dt-k">■ barabashflow studio</span>
                  <span class="dt-hint" data-i18n="dots.hint">Porusz kursorem</span>
                  <span class="dt-meta"><b>{projects.length}</b> <span data-i18n="dots.projects">projektów</span> · PL / EN / RU</span>
                  {hasReel && <button class="dt-play" type="button" data-reel><span class="reel-ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M5 3.5v9l7.5-4.5z" fill="currentColor"/></svg></span><span data-i18n="reel.open">Showreel</span></button>}
                </div>
              )}
            </div>
          </div>
          <aside class="author-line" aria-label="Autor">
            <img class="author-avatar" src={ownerPhoto || '/assets/img/logo.png'} alt="" width="32" height="32" />
            <p><a href="/o-mnie/" rel="author"><strong>{s(settings, 'owner_name', 'pl', AUTHOR_NAME)}</strong></a> · <span data-i18n="home.author.updated">Ostatnia aktualizacja</span> <time datetime={BUILT}>{formatDatePl(BUILT)}</time></p>
            <details class="author-src">
              <summary data-i18n="home.sources.short">Standardy i źródła</summary>
              <p><span data-i18n="home.author.role">web developer, założyciel BarabashFlow — projektuje i koduje wszystkie opisane tu realizacje oraz pisze wpisy na blogu.</span> <span data-i18n="home.author.published">Strona opublikowana</span> <time datetime={SITE_PUBLISHED}>{formatDatePl(SITE_PUBLISHED)}</time>. {SOURCES.map((src, i) => <><a href={src.url} rel="noopener" target="_blank">{src.label}</a>{i < SOURCES.length - 1 ? ' · ' : ''}</>)} · <a href="/zasady-redakcyjne/" data-i18n="nav.editorial">Zasady redakcyjne</a></p>
            </details>
          </aside>
        </div>
      </section>
      <div class="divider" aria-hidden="true"></div>

      <!-- ── SERVICES ─────────────────────────────────────────────────── -->
      <section class="sec" id="uslugi">
        <div class="sec-inner">
          <div class="sec-head is-center" style="padding: clamp(40px,6vw,80px) 18px 0; margin-bottom: clamp(28px,4vw,56px);">
            <span class="kicker" data-i18n="home.services.kicker">Usługi</span>
            <h2 class="h-sec is-center" data-i18n="home.services.title">Co dla Ciebie zbuduję</h2>
          </div>
          <div class="services-grid">
            {services.map((sv, i) => <ServiceCard sv={sv} i={i} />)}
          </div>
        </div>
      </section>
      <div class="divider" aria-hidden="true"></div>

      <!-- ── APPROACH ─────────────────────────────────────────────────── -->
      <section class="sec">
        <div class="sec-inner is-grey vision tick">
          <span class="tick-tr"></span><span class="tick-br"></span>
          <span class="kicker is-white" data-i18n="home.vision.kicker">Podejście</span>
          <h2 class="h-sec" style="margin-top:18px">
            <span data-i18n="home.vision.a">Każdy projekt zaczynam</span><br />
            <span data-i18n="home.vision.b">od</span>
            <span class="inline-img" aria-hidden="true">{visionImg && <img src={visionImg} alt="" loading="lazy" />}</span>
            <span data-i18n="home.vision.c">zrozumienia</span><br />
            <span data-i18n="home.vision.d">celu Twojej firmy</span>
          </h2>
        </div>
      </section>
      <div class="divider" aria-hidden="true"></div>

      <!-- ── PROJECT REEL (pinned drum, lib/reel.ts) ──────────────────── -->
      <ProjectReel projects={reelProjects} total={projects.length} />
      <div class="divider" aria-hidden="true"></div>

      <!-- ── PROCESS ──────────────────────────────────────────────────── -->
      <section class="sec" id="proces">
        <div class="sec-inner sec-pad">
          <div class="process">
            <div class="process-left">
              <span class="kicker" data-i18n="home.process.kicker">Proces</span>
              <h2 class="h-sec" data-i18n="home.process.title">Jasny plan od briefu do startu</h2>
              <div>
                <a class="btn btn-dark with-icon" href="#contact">
                  <span class="btn-ico"><svg viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M13 3H6M13 3v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  <span data-i18n="home.process.cta">Zacznij projekt</span>
                </a>
              </div>
            </div>
            <div class="steps">
              {[1, 2, 3, 4].map((n) => (
                <div class="step" data-reveal>
                  <div class="step-media tile-pattern dot-tile is-step" data-dots={['24H', 'UX', '</>', 'GO'][n - 1]} aria-hidden="true"><canvas></canvas><span class="tp-num">0{n}</span></div>
                  <div class="step-row">
                    <span class="step-num">//0{n}</span>
                    <div>
                      <h3 data-i18n={`process.${n}.t`}>{['Brief i wycena', 'Struktura i treści', 'Projekt i kod', 'Start i opieka'][n - 1]}</h3>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
      <div class="divider" aria-hidden="true"></div>

      <!-- ── MARQUEE ──────────────────────────────────────────────────── -->
      <section class="sec">
        <div class="sec-inner is-grey marquee" aria-hidden="true">
          <div class="marquee-row">
            {[1, 2].map(() => ['marquee.1', 'marquee.2', 'marquee.3'].map((k) => <span data-i18n={k}>{k}</span>))}
          </div>
          <div class="marquee-row is-rev">
            {[1, 2].map(() => ['marquee.4', 'marquee.5', 'marquee.6'].map((k) => <span data-i18n={k}>{k}</span>))}
          </div>
        </div>
      </section>
      <div class="divider" aria-hidden="true"></div>

      <!-- ── WHY ──────────────────────────────────────────────────────── -->
      <section class="sec">
        <div class="sec-inner is-dark why-sec">
          <div class="why-statement">
            <span class="kicker is-white" data-i18n="home.why.kicker">Różnica</span>
            <h2 class="ws-h"><span data-i18n="why.s.a">Bez agencji. Bez szablonów.</span><br /><em data-i18n="why.s.b">Kod, który należy do Ciebie.</em></h2>
            <ul class="ws-facts">{[1, 3, 5].map((n) => <li data-i18n={`why.r.${n}`}>…</li>)}</ul>
            <a class="btn btn-lime" href="#contact" data-i18n="home.why.cta">Porozmawiajmy</a>
          </div>
        </div>
      </section>
      <div class="divider" aria-hidden="true"></div>

      <!-- ── BLOG ─────────────────────────────────────────────────────── -->
      {posts.length > 0 && (
        <>
          <section class="sec" id="blog">
            <div class="sec-inner is-grey sec-pad">
              <div class="sec-head is-split">
                <div>
                  <span class="kicker is-white" data-i18n="home.blog.kicker">Blog</span>
                  <h2 class="h-sec" style="margin-top:18px" data-i18n="home.blog.title">Ostatnio na blogu</h2>
                </div>
                <a class="btn btn-white" href="/blog/" data-i18n="home.blog.all">Wszystkie wpisy</a>
              </div>
              <div class="blog-grid">
                {posts.map((p) => <BlogCard p={p} />)}
              </div>
            </div>
          </section>
          <div class="divider" aria-hidden="true"></div>
        </>
      )}

      <!-- ── FAQ ──────────────────────────────────────────────────────── -->
      {faq.length > 0 && (
        <section class="sec" id="faq">
          <div class="sec-inner sec-pad">
            <div class="sec-head is-center">
              <span class="kicker" data-i18n="home.faq.kicker">FAQ</span>
              <h2 class="h-sec is-center" data-i18n="home.faq.title">Częste pytania</h2>
            </div>
            <FaqList items={faq} />
          </div>
        </section>
      )}
    </div>
  </main>

  {hasReel && (
    <div class="reel" id="reel" hidden role="dialog" aria-modal="true" aria-label="Showreel BarabashFlow">
      <button class="reel-x" type="button" data-reel-close aria-label="Zamknij"><svg viewBox="0 0 20 20" fill="none"><path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
      <div class="reel-frame">
        <video controls playsinline preload="none" poster="/assets/video/poster.jpg" data-src-hd="/assets/video/showreel-1080.mp4" data-src-sd="/assets/video/showreel-720.mp4"></video>
      </div>
      <p class="reel-k">■ BarabashFlow · Showreel {new Date().getFullYear()}</p>
    </div>
  )}
  <SiteFooter services={services} settings={settings} />

  <script>
    import { mountShell } from '../lib/shell';
    import { mountLogo3D } from '../lib/logo3d';
    import { setupProjectReel } from '../lib/reel';
    import { setupHeroWidgets, setupReel, setupReelInline } from '../lib/fx';
    mountShell();
    setupHeroWidgets();
    setupReel();
    setupReelInline();
    setupProjectReel();
    // 3D mark after first paint — three.js is a separate lazy chunk.
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(() => mountLogo3D(), { timeout: 1200 });
    else setTimeout(() => mountLogo3D(), 300);
  </script>
</Base>
