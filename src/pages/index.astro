---
import Base from '../layouts/Base.astro';
import '../styles/main.css';
import { restGet } from '../lib/supabase';

// Build-time fetch so crawlers and social/LLM bots see real project names in
// the static HTML (the interactive graph hydrates on top at runtime). Falls
// back to an empty list if Supabase is unreachable at build — the page still
// renders and the client refetches live data anyway.
const seoProjects = await restGet<{ title_pl: string; category_key: string }>(
  'projects?select=title_pl,category_key&is_published=eq.true&order=sort_order.asc',
);

// Decorative data-viz garnish (deterministic, generated at build):
// dot-meter columns for the mesh stat tiles + the colored "pulse" dot strip.
let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const METER_A = [3, 5, 2, 6, 4, 7, 3, 5, 8, 4, 6, 3, 7, 5, 2, 6];
const METER_B = [2, 4, 6, 3, 7, 5, 8, 4, 3, 6, 2, 5, 7, 4, 6, 3];
const PULSE_COLORS = ['#7fb44c', '#f0a24a', '#e2447f', '#c9c9c1', '#c9c9c1', '#c9c9c1', '#c9c9c1'];
const pulseDots = Array.from({ length: 52 }, () => ({
  size: (1.4 + rnd() * 2.4) * 2,
  y: (rnd() - 0.5) * 14,
  color: PULSE_COLORS[Math.floor(rnd() * PULSE_COLORS.length)],
  dim: rnd() < 0.45,
}));
---
<Base bodyClass="is-loading">
  <!-- ── Static semantic layer (SEO/GEO) — visually hidden, always in the DOM ── -->
  <section class="sr-only" aria-hidden="false">
    <h2>BarabashFlow — tworzenie stron internetowych i platform</h2>
    <p>
      BarabashFlow to studio Dmytrija Barabasha z Warszawy. Projektuję i wdrażam
      nowoczesne, szybkie strony internetowe, platformy i aplikacje webowe dla
      firm w Polsce i za granicą. Websites and internet platforms. Разработка
      сайтов, платформ и веб-приложений под ключ.
    </p>
    <h3>Usługi</h3>
    <ul>
      <li>Tworzenie stron internetowych i stron-wizytówek</li>
      <li>Platformy internetowe i aplikacje webowe na zamówienie</li>
      <li>Panele administracyjne i systemy CMS</li>
      <li>Sklepy internetowe / e-commerce</li>
      <li>Wdrożenia Astro, Next.js, React, Supabase</li>
    </ul>
    {seoProjects.length > 0 && (
      <>
        <h3>Zrealizowane projekty</h3>
        <ul>
          {seoProjects.map((p) => <li>{p.title_pl}</li>)}
        </ul>
      </>
    )}
  </section>

  <div class="app">
    <!-- ── Top bar ── -->
    <header class="topbar">
      <a class="brand" href="/" aria-label="BarabashFlow">
        <img class="brand-logo" src="/assets/img/logo.png" alt="" draggable="false" />
        <span class="brand-name">Barabashflow</span>
      </a>

      <nav class="nav" aria-label="Site navigation">
        <span class="status pill" aria-label="Availability">
          <span class="status-dot" aria-hidden="true"></span>
          <span class="status-text" data-i18n="meta.available">Dostępny</span>
        </span>
        <a class="chip" href="/blog/" data-i18n="nav.blog">Blog</a>
        <div class="nav-group lang pill" aria-label="Language switcher"></div>
        <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle theme" title="Theme">
          <svg viewBox="0 0 20 20" fill="none" id="theme-icon" aria-hidden="true">
            <path d="M14.5 11.5a5.5 5.5 0 0 1-7-7 5.5 5.5 0 1 0 7 7Z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="icon-btn" id="contact-link" type="button" aria-label="Kontakt" title="Kontakt">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3.5 5.5h13v9h-13zM3.5 5.5l6.5 5 6.5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </nav>
    </header>

    <!-- ── Hero ── -->
    <section class="hero">
      <div class="hero-chips">
        <span class="portrait" id="owner-portrait" data-empty="true" aria-hidden="true"></span>
        <span class="chip" data-i18n="hero.eyebrow">Studio Indywidualne</span>
        <span class="chip" data-i18n="meta.location">Warszawa → Świat</span>
        <span class="chip chip-lime">PL · EN · RU</span>
      </div>
      <h1 class="hero-title" id="hero-title">Strony internetowe <em>i</em> platformy</h1>
      <p class="hero-sub" id="hero-sub"></p>
      <div class="hero-actions">
        <button type="button" class="cta" id="cta" data-open-contact>
          <span class="cta-label">Zlecić projekt</span>
          <svg class="cta-arrow" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <a class="ghost-cta" href="#works" data-i18n="hero.see-work">Zobacz projekty</a>
      </div>

      <!-- Colored pulse strip (decorative, reference-style dot timeline) -->
      <div class="pulse-strip" aria-hidden="true">
        {pulseDots.map((d) => (
          <span
            class="pulse-dot"
            style={`width:${d.size.toFixed(1)}px;height:${d.size.toFixed(1)}px;transform:translateY(${d.y.toFixed(1)}px);background:${d.color};opacity:${d.dim ? 0.45 : 0.95}`}
          ></span>
        ))}
      </div>

      <!-- Dot-matrix stat strip -->
      <div class="stats-strip" aria-label="Statystyki">
        <div class="stat stat-mesh mesh-green">
          <span class="stat-num" id="stat-projects">—</span>
          <span class="dot-meter">
            {METER_A.map((n) => <span class="meter-col" style={`height:${n * 6}px`}></span>)}
          </span>
          <span class="stat-label"><span data-i18n="stats.projects">Projekty w grafie</span> <span class="chip chip-glass chip-xs">live</span></span>
        </div>
        <div class="stat">
          <span class="stat-num">3</span>
          <span class="stat-label" data-i18n="stats.langs">Języki obsługi</span>
        </div>
        <div class="stat">
          <span class="stat-num">24h</span>
          <span class="stat-label" data-i18n="stats.reply">Odpowiedź na brief</span>
        </div>
        <div class="stat stat-mesh mesh-orange">
          <span class="stat-num">100%</span>
          <span class="dot-meter">
            {METER_B.map((n) => <span class="meter-col" style={`height:${n * 6}px`}></span>)}
          </span>
          <span class="stat-label" data-i18n="stats.custom">Kod na miarę, zero szablonów</span>
        </div>
      </div>
    </section>

    <!-- ── Graph section ── -->
    <section class="graph-section" id="works">
      <div class="section-head">
        <span class="chip kicker" data-i18n="sec.works.kicker">Portfolio</span>
        <h2 class="section-title" data-i18n="sec.works.title">Mapa zrealizowanych projektów</h2>
        <p class="section-sub graph-caption" id="graph-caption"></p>
      </div>

      <div class="graph-card">
        <main class="stage" id="graph-canvas">
          <div class="stage-inner" id="stage-inner">
            <svg id="graph-edges" aria-hidden="true"></svg>
            <div id="logo-stage" aria-hidden="true">
              <span id="logo-fallback">BF</span>
              <span id="logo-status"></span>
            </div>
          </div>
          <span class="zoom-indicator" id="zoom-indicator">100%</span>
          <div class="graph-tools" aria-hidden="false">
            <button type="button" class="tool-btn" id="zoom-out" aria-label="Oddal">−</button>
            <button type="button" class="tool-btn" id="zoom-in" aria-label="Przybliż">+</button>
            <button type="button" class="tool-btn" id="zoom-reset" aria-label="Dopasuj widok">
              <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 5V1h4M13 9v4H9M13 5V1H9M1 9v4h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <div class="graph-pan-hint" id="graph-pan-hint" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 5l3-3 3 3M9 19l3 3 3-3M5 9l-3 3 3 3M19 9l3 3-3 3M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span data-i18n="graph.pan-hint">To graf — przeciągnij, by przesunąć</span>
          </div>
        </main>
      </div>
    </section>

    <!-- ── Services ── -->
    <section class="services" data-reveal>
      <div class="section-head">
        <span class="chip kicker" data-i18n="sec.services.kicker">Usługi</span>
        <h2 class="section-title" data-i18n="sec.services.title">Co mogę dla Ciebie zbudować</h2>
        <p class="section-sub" data-i18n="sec.services.sub">Od strony-wizytówki po platformę z własnym panelem — projekt, kod i wdrożenie w jednych rękach.</p>
      </div>
      <div class="services-grid">
        <article class="svc-card">
          <span class="svc-icon" aria-hidden="true">
            <svg viewBox="0 0 22 22" fill="none"><rect x="2" y="3.5" width="18" height="14" rx="2.6" stroke="currentColor" stroke-width="1.5"/><path d="M2 8h18" stroke="currentColor" stroke-width="1.5"/><circle cx="5" cy="5.8" r="0.9" fill="currentColor"/><circle cx="7.6" cy="5.8" r="0.9" fill="currentColor"/></svg>
          </span>
          <h3 class="svc-title" data-i18n="svc.site.t">Strony internetowe</h3>
          <p class="svc-desc" data-i18n="svc.site.d">Szybkie, dopracowane strony firmowe i wizytówki, które ładują się natychmiast i dobrze pozycjonują.</p>
        </article>
        <article class="svc-card">
          <span class="svc-icon" aria-hidden="true">
            <svg viewBox="0 0 22 22" fill="none"><rect x="2.5" y="2.5" width="7.5" height="7.5" rx="2" stroke="currentColor" stroke-width="1.5"/><rect x="12" y="2.5" width="7.5" height="7.5" rx="2" stroke="currentColor" stroke-width="1.5"/><rect x="2.5" y="12" width="7.5" height="7.5" rx="2" stroke="currentColor" stroke-width="1.5"/><rect x="12" y="12" width="7.5" height="7.5" rx="2" stroke="currentColor" stroke-width="1.5"/></svg>
          </span>
          <h3 class="svc-title" data-i18n="svc.platform.t">Platformy i aplikacje</h3>
          <p class="svc-desc" data-i18n="svc.platform.d">Aplikacje webowe na zamówienie: rezerwacje, kalendarze, portale klienta, integracje z API.</p>
        </article>
        <article class="svc-card">
          <span class="svc-icon" aria-hidden="true">
            <svg viewBox="0 0 22 22" fill="none"><path d="M11 3l7 3.5v4.8c0 4-2.8 6.6-7 7.7-4.2-1.1-7-3.7-7-7.7V6.5L11 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8.2 11l2 2 3.6-3.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <h3 class="svc-title" data-i18n="svc.cms.t">Panele CMS i admin</h3>
          <p class="svc-desc" data-i18n="svc.cms.d">Własny panel do edycji treści, zdjęć i zamówień — bez abonamentów i bez WordPressa.</p>
        </article>
        <article class="svc-card">
          <span class="svc-icon" aria-hidden="true">
            <svg viewBox="0 0 22 22" fill="none"><path d="M3 4h2.2l1.6 10.2c.1.7.7 1.3 1.5 1.3h8.2c.7 0 1.3-.5 1.5-1.2L19.5 8H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.4" cy="18.6" r="1.3" fill="currentColor"/><circle cx="15.6" cy="18.6" r="1.3" fill="currentColor"/></svg>
          </span>
          <h3 class="svc-title" data-i18n="svc.shop.t">Sklepy internetowe</h3>
          <p class="svc-desc" data-i18n="svc.shop.d">E-commerce z płatnościami, katalogiem i panelem sprzedaży — dopasowany do Twojego produktu.</p>
        </article>
      </div>
    </section>

    <!-- ── Process ── -->
    <section class="process" data-reveal>
      <div class="section-head">
        <span class="chip kicker" data-i18n="sec.process.kicker">Proces</span>
        <h2 class="section-title" data-i18n="sec.process.title">Jak wygląda współpraca</h2>
      </div>
      <div class="process-grid">
        <article class="proc-card mesh-green">
          <span class="proc-num">01</span>
          <div class="proc-body">
            <h3 class="proc-title" data-i18n="proc.1.t">Brief i wycena</h3>
            <p class="proc-desc" data-i18n="proc.1.d">Opisujesz pomysł — w 24 h dostajesz plan, zakres i konkretną wycenę.</p>
          </div>
        </article>
        <article class="proc-card mesh-orange">
          <span class="proc-num">02</span>
          <div class="proc-body">
            <h3 class="proc-title" data-i18n="proc.2.t">Projekt i budowa</h3>
            <p class="proc-desc" data-i18n="proc.2.d">Design i kod powstają razem — widzisz postęp na żywo i zgłaszasz uwagi.</p>
          </div>
        </article>
        <article class="proc-card mesh-pink">
          <span class="proc-num">03</span>
          <div class="proc-body">
            <h3 class="proc-title" data-i18n="proc.3.t">Wdrożenie i opieka</h3>
            <p class="proc-desc" data-i18n="proc.3.d">Domena, hosting, panel — wszystko działa. Zostaję do pomocy po starcie.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- ── FAQ ── -->
    <section class="faq" data-reveal>
      <div class="section-head">
        <span class="chip kicker">FAQ</span>
        <h2 class="section-title" data-i18n="sec.faq.title">Częste pytania</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary>
            <span data-i18n="faq.1.q">Ile kosztuje strona internetowa?</span>
            <span class="faq-plus" aria-hidden="true"></span>
          </summary>
          <p data-i18n="faq.1.a">Koszt zależy od zakresu — od prostej strony-wizytówki po rozbudowaną platformę z panelem CMS. Napisz przez formularz, przygotuję wycenę dopasowaną do projektu.</p>
        </details>
        <details class="faq-item">
          <summary>
            <span data-i18n="faq.2.q">Jak długo trwa realizacja?</span>
            <span class="faq-plus" aria-hidden="true"></span>
          </summary>
          <p data-i18n="faq.2.a">Strona-wizytówka to zwykle 1–2 tygodnie, platforma z panelem — od kilku tygodni. Dokładny harmonogram dostajesz razem z wyceną.</p>
        </details>
        <details class="faq-item">
          <summary>
            <span data-i18n="faq.3.q">W jakich technologiach pracujesz?</span>
            <span class="faq-plus" aria-hidden="true"></span>
          </summary>
          <p data-i18n="faq.3.a">Astro, React, Next.js, Supabase, Three.js. Strony są statyczne i wdrażane na GitHub Pages / Cloudflare — dzięki temu ładują się natychmiast.</p>
        </details>
      </div>
    </section>

    <!-- ── Contact band ── -->
    <section class="contact-band" data-reveal>
      <div class="contact-card">
        <span class="chip kicker" data-i18n="contact.eyebrow">Współpraca</span>
        <h2 class="contact-title" data-i18n="cta.title">Masz pomysł na projekt?</h2>
        <p class="contact-sub" data-i18n="cta.sub">Opowiedz o nim w dwóch zdaniach — odpiszę w ciągu 24 godzin z planem i wyceną.</p>
        <div class="contact-actions">
          <button type="button" class="cta cta-lime" data-open-contact>
            <span class="cta-label">Zlecić projekt</span>
            <svg class="cta-arrow" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <a class="ghost-cta" href="mailto:office@barabashflow.pl">office@barabashflow.pl</a>
        </div>
      </div>
    </section>

    <!-- ── Footer ── -->
    <footer class="footer">
      <span class="footer-item strong">Barabashflow · MMXXVI</span>
      <a class="footer-item" href="/blog/" data-i18n="nav.blog">Blog</a>
      <span class="footer-item" data-i18n="meta.location">Warszawa → Świat</span>
      <a class="footer-item" href="mailto:office@barabashflow.pl">office@barabashflow.pl</a>
    </footer>
  </div>

  <!-- ── Project modal ── -->
  <div class="modal-root" id="modal-project" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal-backdrop" data-close-modal></div>
    <div class="modal">
      <button class="modal-close" data-close-modal aria-label="Zamknij" type="button">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
      <div class="modal-scroll">
        <div class="modal-media" aria-hidden="true"></div>
        <div class="modal-body">
          <div class="modal-cat"></div>
          <h2 class="modal-title"></h2>
          <p class="modal-desc"></p>
          <div class="modal-actions">
            <a class="btn primary modal-visit" target="_blank" rel="noopener noreferrer" data-i18n="modal.visit">Otwórz projekt</a>
            <button type="button" class="btn" data-close-modal data-i18n="modal.close">Zamknij</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Contact modal ── -->
  <div class="modal-root contact-modal" id="modal-contact" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal-backdrop" data-close-modal></div>
    <div class="modal">
      <button class="modal-close" data-close-modal aria-label="Zamknij" type="button">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
      <div class="modal-scroll">
        <div class="modal-body">
          <div class="modal-cat" data-i18n="contact.eyebrow">Współpraca</div>
          <h2 class="modal-title" data-i18n="contact.title">Porozmawiajmy</h2>
          <p class="contact-intro"></p>
          <form class="form" id="contact-form" autocomplete="on" novalidate>
            <div class="field">
              <label for="cf-name" data-i18n="contact.name">Imię</label>
              <input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" />
            </div>
            <div class="field">
              <label for="cf-email" data-i18n="contact.email">E-mail</label>
              <input id="cf-email" name="email" type="email" required maxlength="160" autocomplete="email" />
            </div>
            <div class="field">
              <label for="cf-msg" data-i18n="contact.message">Wiadomość</label>
              <textarea id="cf-msg" name="message" required maxlength="4000" rows="4"></textarea>
            </div>
            <div class="form-status"></div>
            <div class="modal-actions">
              <button type="button" class="btn" data-close-modal data-i18n="modal.close">Zamknij</button>
              <button type="submit" class="btn primary" data-i18n="contact.submit">Wyślij</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Cookie consent ── -->
  <aside class="cookie-bot" id="cookie-bot" aria-hidden="true" aria-live="polite">
    <div class="cookie-card">
      <button class="cookie-close" type="button" aria-label="Zamknij" data-cookie-close>×</button>
      <p class="cookie-text">Używamy kukisów, żeby zapamiętać motyw i język. Bez śledzenia, bez zewnętrznych skryptów.</p>
      <div class="cookie-actions">
        <button class="cookie-accept" id="cookie-accept" type="button">Akceptuję</button>
        <button class="cookie-policy" id="cookie-policy-open" type="button">Polityka</button>
      </div>
    </div>
  </aside>

  <!-- ── Cookie policy modal ── -->
  <div class="modal-root" id="modal-cookies" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal-backdrop" data-close-modal></div>
    <div class="modal cookie-policy-modal">
      <button class="modal-close" data-close-modal aria-label="Zamknij" type="button">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
      <div class="modal-scroll">
        <div class="modal-body">
          <div class="modal-cat">Polityka cookies</div>
          <h2 class="modal-title">Pliki cookie i dane lokalne</h2>
          <div class="cookie-policy-body">
            <p>BarabashFlow szanuje Twoją prywatność. Strona używa wyłącznie <strong>kukisów przeglądarki</strong> (mechanizm pamięci lokalnej) — żadnych ciasteczek śledzących, żadnych zewnętrznych skryptów analitycznych, żadnych third-party.</p>
            <h4>Co zapamiętujemy</h4>
            <ul>
              <li>motyw (jasny / ciemny) — <code>bf:theme</code></li>
              <li>język interfejsu (PL / EN / RU) — <code>bf:locale</code></li>
              <li>Twoją zgodę na ten dialog — <code>bf:cookies-accepted</code></li>
              <li>zamknięcie okienka maskotki w bieżącej sesji — <code>bf:mascot-dismissed</code></li>
            </ul>
            <h4>Czego NIE używamy</h4>
            <ul>
              <li>Google Analytics, Facebook Pixel, Hotjar ani innych narzędzi analitycznych zewnętrznych firm.</li>
              <li>Kukisów reklamowych.</li>
              <li>Kukisów śledzących między stronami.</li>
              <li>Nie sprzedajemy, nie wymieniamy ani nie udostępniamy Twoich danych nikomu.</li>
            </ul>
            <h4>Twoje wiadomości</h4>
            <p>Gdy wyślesz wiadomość przez formularz kontaktowy lub okienko maskotki, Twój adres e-mail i treść trafiają wyłącznie do skrzynki właściciela strony, w celu odpowiedzi na zapytanie. Dane przechowywane są w bazie Supabase z restrykcyjnymi politykami RLS — czyta je tylko właściciel.</p>
            <h4>Jak wyczyścić zapisane dane</h4>
            <p>W każdej chwili możesz wyczyścić kukisy w ustawieniach swojej przeglądarki. Strona nadal będzie działać — po prostu zapomni Twoje preferencje motywu i języka. Ten dialog zgody pojawi się ponownie.</p>
            <h4>Kontakt</h4>
            <p>W razie pytań lub żądań związanych z danymi — formularz kontaktowy na stronie głównej lub adres e-mail właściciela.</p>
          </div>
          <div class="modal-actions">
            <button type="button" class="btn primary" data-close-modal>Rozumiem</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Mascot bot ── -->
  <aside class="mascot-bot" id="mascot-bot" aria-hidden="true" aria-live="polite">
    <div class="mascot-card">
      <button class="mascot-close" type="button" aria-label="Zamknij" data-mascot-close>
        <svg viewBox="0 0 14 14" fill="none" width="11" height="11"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
      <div class="mascot-row">
        <div class="mascot-avatar">
          <img src="/assets/img/maskot.png" alt="" draggable="false" />
        </div>
        <div class="mascot-body">
          <div class="mascot-stage" data-stage="ask">
            <p class="mascot-bubble" id="mascot-greeting" aria-live="polite"></p>
            <form class="mascot-form" id="mascot-form" novalidate>
              <label class="sr-only" for="mascot-q">Pytanie</label>
              <input id="mascot-q" name="question" type="text" autocomplete="off" maxlength="600" required />
              <label class="sr-only" for="mascot-email">E-mail</label>
              <input id="mascot-email" name="email" type="email" autocomplete="email" maxlength="160" required />
              <div class="mascot-foot">
                <button type="submit" class="mascot-send" id="mascot-send"></button>
                <span class="mascot-status" id="mascot-status"></span>
              </div>
            </form>
          </div>
          <div class="mascot-stage" data-stage="done" hidden>
            <h4 class="mascot-success-title" id="mascot-success-title"></h4>
            <p class="mascot-success-text" id="mascot-success-text"></p>
          </div>
        </div>
      </div>
    </div>
  </aside>

