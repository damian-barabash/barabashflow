---
// Home — hero with the 3D mark, trusted strip, studio + stats, services,
// approach, featured projects, process, marquee, why-us, blog, FAQ; the CTA
// band + contact + footer come from SiteFooter. All CMS content is baked in
// at build (PL in markup, EN/RU in data-lm-* attributes).
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FaqList from '../components/FaqList.astro';
import BlogCard from '../components/BlogCard.astro';
import { mediaUrl } from '../lib/supabase';
import { fetchSettings, fetchServices, fetchProjects, fetchFaq, s, lm, lmRow, projectCover, categoryLm, firstSentence, type Project } from '../lib/content';
import { restGet } from '../lib/supabase';
import { SITE, AUTHOR_NAME, SITE_PUBLISHED, SOURCES } from '../lib/site';
import { formatDatePl, type BlogPost } from '../lib/blog';

const [settings, services, projects, faq, posts] = await Promise.all([
  fetchSettings(), fetchServices(), fetchProjects(), fetchFaq('home'),
  restGet<BlogPost>('blog_posts?select=slug,title_pl,title_en,title_ru,excerpt_pl,excerpt_en,excerpt_ru,cover_path,cover_alt,published_at,tags&status=eq.published&order=published_at.desc&limit=3'),
]);
const featured = (projects.filter((p) => p.is_featured).length ? projects.filter((p) => p.is_featured) : projects).slice(0, 4);
const trusted = projects.map((p) => ({ name: p.client || p.title_pl, slug: p.slug })).filter((x, i, a) => a.findIndex((y) => y.name === x.name) === i && !/barabash/i.test(x.name)).slice(0, 6);
const stats: any[] = settings.home_stats?.value_meta?.items || [];
const ownerPhoto = mediaUrl(settings.owner_photo_path?.value_meta?.path);
const visionImg = projectCover(featured[0]);

const title = 'Strony, sklepy i platformy — Warszawa | BarabashFlow';
const description = 'BarabashFlow, Warszawa: tworzenie stron internetowych, sklepów i platform na zamówienie. Kod na miarę, własny CMS, wycena projektu w 24 h — bez szablonów.';
const heroSub = s(settings, 'hero_subtitle', 'pl', 'Kod na miarę, własny panel CMS i wycena projektu w 24 h.');
const BUILT = new Date().toISOString().slice(0, 10);
const priceLine = services.filter((sv) => sv.price_from).slice(0, 3);
const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE}/#webpage`,
  url: `${SITE}/`,
  name: title,
  description,
  inLanguage: 'pl',
  datePublished: SITE_PUBLISHED,
  dateModified: BUILT,
  author: { '@id': `${SITE}/#person` },
  publisher: { '@id': `${SITE}/#organization` },
  isPartOf: { '@id': `${SITE}/#website` },
};

const faqLd = faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.question_pl, acceptedAnswer: { '@type': 'Answer', text: f.answer_pl } })),
} : null;
const servicesLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Usługi BarabashFlow',
  itemListElement: services.map((sv, i) => ({ '@type': 'ListItem', position: i + 1, name: sv.title_pl, url: `${SITE}/uslugi/${sv.slug}/` })),
};
const ICONS: Record<string, string> = {
  site: '<path d="M3 5h18v14H3z"/><path d="M3 9h18M7 7h.01M10 7h.01"/>',
  shop: '<path d="M4 7h16l-1 13H5z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/>',
  platform: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  care: '<path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z"/>',
};
const tagOf = (p: Project) => ({
  pl: p.tagline_pl || firstSentence(p.description_pl),
  en: p.tagline_en || firstSentence(p.description_en) || p.tagline_pl || firstSentence(p.description_pl),
  ru: p.tagline_ru || firstSentence(p.description_ru) || p.tagline_pl || firstSentence(p.description_pl),
});
---
<Base title={title} description={description} jsonLd={[webPageLd, servicesLd, ...(faqLd ? [faqLd] : [])]} bodyClass="is-home" modified={BUILT}>
  <SiteHeader active="home" />

  <main>
    <div class="container">
      <!-- ── HERO ─────────────────────────────────────────────────────── -->
      <section class="sec">
        <div class="hero">
          <div class="hero-inner">
            <div class="px is-tl" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <div class="px is-br" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
            <div class="arrow-track is-left" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 4h3l6 8-6 8H6l6-8z"/></svg><svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 4h3l6 8-6 8H6l6-8z"/></svg><svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 4h3l6 8-6 8H6l6-8z"/></svg>
            </div>
            <div class="arrow-track is-right" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M18 4h-3l-6 8 6 8h3l-6-8z"/></svg><svg viewBox="0 0 24 24"><path fill="currentColor" d="M18 4h-3l-6 8 6 8h3l-6-8z"/></svg><svg viewBox="0 0 24 24"><path fill="currentColor" d="M18 4h-3l-6 8 6 8h3l-6-8z"/></svg>
            </div>

            <div class="hero-copy">
              <div class="hero-kicker">
                <span class="kicker is-white"><span class="status-dot" aria-hidden="true"></span><span data-i18n="meta.available">Dostępny</span></span>
                <span class="kicker is-white" {...lm(settings, 'hero_kicker')}>{s(settings, 'hero_kicker')}</span>
              </div>
              <h1 class="hero-h1" {...lm(settings, 'hero_title')}>{s(settings, 'hero_title', 'pl', 'Strony internetowe, sklepy i platformy na zamówienie — Warszawa')}</h1>
              <p class="hero-sub" {...lm(settings, 'hero_subtitle')}>{heroSub}</p>
              <div class="hero-actions">
                <a class="btn btn-dark with-icon" href="#contact">
                  <span class="btn-ico"><svg viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M13 3H6M13 3v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  <span {...lm(settings, 'cta_label', 'Wycena w 24 h')}>{s(settings, 'cta_label', 'pl', 'Wycena w 24 h')}</span>
                </a>
                <a class="btn btn-white" href="/projekty/" {...lm(settings, 'cta_secondary', 'Zobacz projekty')}>{s(settings, 'cta_secondary', 'pl', 'Zobacz projekty')}</a>
              </div>
              {priceLine.length > 0 && (
                <p class="hero-price"><span class="hp-k" data-i18n="hero.prices">Orientacyjnie</span>{priceLine.map((sv) => <a href={`/uslugi/${sv.slug}/`}><span {...lmRow(sv, 'title')}>{sv.title_pl}</span> <b>{sv.price_from}</b></a>)}</p>
              )}
            </div>
            <div class="hero-visual" aria-hidden="true">
              <span class="hero-word" {...lm(settings, 'hero_word_a')}>{s(settings, 'hero_word_a', 'pl', 'TWORZYMY')}</span>
              <div class="hero-logo-card">
                <div id="hero-logo" aria-label="Logo 3D BarabashFlow — przeciągnij, aby obrócić">
                  <div class="hero-logo-fallback"><img src="/assets/img/logo.png" alt="" width="326" height="402" /></div>
                </div>
              </div>
              <span class="hero-word" {...lm(settings, 'hero_word_b')}>{s(settings, 'hero_word_b', 'pl', 'STRONY')}</span>
            </div>
          </div>
        </div>
      </section>

      <!-- trusted strip -->
      {trusted.length > 0 && (
        <section class="sec">
          <div class="sec-inner trusted">
            <span class="label"><span data-i18n="home.trusted">Zaufali mi</span></span>
            {trusted.map((t) => <a class="name" href={`/projekty/${t.slug}/`}>{t.name}</a>)}
          </div>
        </section>
      )}
      <div class="divider" aria-hidden="true"></div>

      <!-- ── STUDIO + STATS ───────────────────────────────────────────── -->
      <section class="sec" id="o-studiu">
        <div class="sec-inner sec-pad">
          <div class="sec-head">
            <span class="kicker" data-i18n="home.about.kicker">O studiu</span>
            <h2 class="h-sec" {...lm(settings, 'about_title')}>{s(settings, 'about_title')}</h2>
          </div>
          <div class="about-grid">
            <div>
              <ul class="stats">
                <li class="note" data-i18n="home.about.note">Liczby, które mówią same za siebie.</li>
                {stats.map((st, i) => {
                  const isAuto = st.auto === 'projects';
                  const num = isAuto ? String(projects.length) : String(st.value);
                  const numeric = /^\d+(\.\d+)?$/.test(num);
                  const suffix = st.suffix || '';
                  return (
                    <li class="stat">
                      <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={[ICONS.site, ICONS.platform, '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>', ICONS.care][i % 4]} /></span>
                      <div>
                        <div class="num">{numeric ? <span data-count={num} data-suffix={suffix} data-final={num + suffix}>{num + suffix}</span> : num + suffix}</div>
                        <div class="lbl" {...lmRow(st, 'label')}>{st.label_pl}</div>
                      </div>
                    </li>
                  );
                })}
              </ul>
              <p class="about-text" {...lm(settings, 'about_text')}>{s(settings, 'about_text')}</p>
              <div class="about-cta">
                <a class="btn btn-ghost" href="/o-mnie/"><span data-i18n="about.kicker">O mnie</span><svg class="btn-arrow" viewBox="0 0 14 14" fill="none"><path d="M3 11 11 3M11 3H5M11 3v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
              </div>
            </div>
            <div class="about-media tile-pattern" data-reveal>
              {ownerPhoto ? <img src={ownerPhoto} alt={s(settings, 'owner_name', 'pl', AUTHOR_NAME)} loading="lazy" /> : <><span class="tp-label">BarabashFlow</span><span class="tp-num">BF</span></>}
            </div>
          </div>
          <aside class="author-strip" aria-label="Autor">
            <img class="author-avatar" src={ownerPhoto || '/assets/img/logo.png'} alt="" width="48" height="48" />
            <div class="author-text">
              <span class="kicker" data-i18n="home.author.kicker">Autor strony</span>
              <p><a href="/o-mnie/" rel="author"><strong>{s(settings, 'owner_name', 'pl', AUTHOR_NAME)}</strong></a> — <span data-i18n="home.author.role">web developer, założyciel BarabashFlow — projektuje i koduje wszystkie opisane tu realizacje oraz pisze wpisy na blogu.</span> <a class="author-more" href="/o-mnie/" data-i18n="home.author.more">O autorze</a></p>
              <p class="author-dates"><span data-i18n="home.author.published">Strona opublikowana</span> <time datetime={SITE_PUBLISHED}>{formatDatePl(SITE_PUBLISHED)}</time> · <span data-i18n="home.author.updated">Ostatnia aktualizacja</span> <time datetime={BUILT}>{formatDatePl(BUILT)}</time></p>
              <p class="author-sources"><span data-i18n="home.sources">Standardy i źródła, według których pracuję:</span> {SOURCES.map((src, i) => <><a href={src.url} rel="noopener" target="_blank">{src.label}</a>{i < SOURCES.length - 1 ? ' · ' : ''}</>)} · <a href="/zasady-redakcyjne/" data-i18n="nav.editorial">Zasady redakcyjne</a></p>
            </div>
          </aside>
        </div>
      </section>
      <div class="divider" aria-hidden="true"></div>

      <!-- ── SERVICES ─────────────────────────────────────────────────── -->
      <section class="sec" id="uslugi">
        <div class="sec-inner">
          <div class="sec-head is-center" style="padding: clamp(40px,6vw,80px) 18px 0; margin-bottom: clamp(28px,4vw,56px);">
            <span class="kicker" data-i18n="home.services.kicker">Usługi</span>
            <h2 class="h-sec is-center" data-i18n="home.services.title">Co dla Ciebie zbuduję</h2>
            <p class="lead" {...lm(settings, 'services_intro')}>{s(settings, 'services_intro')}</p>
          </div>
          <div class="services-grid">
            {services.map((sv, i) => (
              <article class="svc" data-reveal data-reveal-delay={i * 80}>
                <a class="over-link" href={`/uslugi/${sv.slug}/`} aria-label={sv.title_pl}></a>
                <span class="kicker is-dark svc-tag" {...lmRow(sv, 'title')}>{sv.title_pl}</span>
                <p class="tagline" {...lmRow(sv, 'tagline')}>{sv.tagline_pl}</p>
                <div class="svc-num">0{i + 1}</div>
                <ul>
                  {sv.bullets_pl.map((b, j) => <li data-lm-pl={b} data-lm-en={sv.bullets_en[j] || b} data-lm-ru={sv.bullets_ru[j] || b}>{b}</li>)}
                </ul>
                <div class="svc-foot">
                  {sv.price_from && <span class="svc-price"><b>{sv.price_from}</b></span>}
                  <a class="svc-link" href={`/uslugi/${sv.slug}/`} aria-label={`${sv.title_pl} — szczegóły`}><svg viewBox="0 0 16 16" fill="none"><path d="M5 2l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
      <div class="divider" aria-hidden="true"></div>

      <!-- ── APPROACH ─────────────────────────────────────────────────── -->
      <section class="sec">
        <div class="sec-inner is-grey vision tick">
          <span class="tick-tr"></span><span class="tick-br"></span>
          <span class="kicker is-white" data-i18n="home.vision.kicker">Podejście</span>
          <h2 class="h-sec" style="margin-top:18px">
            <span data-i18n="home.vision.a">Każdy projekt zaczynam</span><br />
            <span data-i18n="home.vision.b">od</span>
            <span class="inline-img" aria-hidden="true">{visionImg && <img src={visionImg} alt="" loading="lazy" />}</span>
            <span data-i18n="home.vision.c">zrozumienia</span><br />
            <span data-i18n="home.vision.d">celu Twojej firmy</span>
          </h2>
          <p class="lead" data-i18n="home.vision.p">Nie sprzedaję „ładnych stron”. Najpierw pytam, skąd mają przyjść klienci i co mają zrobić na stronie — a potem projektuję i koduję dokładnie pod ten cel.</p>
        </div>
      </section>
      <div class="divider" aria-hidden="true"></div>

      <!-- ── FEATURED PROJECTS ────────────────────────────────────────── -->
      <section class="sec" id="projekty">
        <div class="sec-inner is-grey sec-pad">
          <div class="sec-head is-split">
            <div>
              <span class="kicker is-white" data-i18n="home.projects.kicker">Projekty</span>
              <h2 class="h-sec" style="margin-top:18px" data-i18n="home.projects.title">Wybrane realizacje</h2>
              <p class="lead" style="margin-top:14px" {...lm(settings, 'projects_intro')}>{s(settings, 'projects_intro')}</p>
            </div>
            <a class="btn btn-white" href="/projekty/" data-i18n="home.projects.all">Wszystkie projekty</a>
          </div>
          <div class="feat-list">
            {featured.map((p) => { const cover = projectCover(p); const tg = tagOf(p); return (
              <article class="feat" data-reveal>
                <a class="feat-media" href={`/projekty/${p.slug}/`}>
                  {cover ? <img src={cover} alt={p.title_pl} loading="lazy" decoding="async" /> : <div class="tile-pattern" style="position:absolute;inset:0"><span class="tp-label">{p.title_pl}</span></div>}
                  <span class="corner" aria-hidden="true"></span>
                </a>
                <div class="feat-body">
                  <div>
                    <span class="cat" {...categoryLm(p)}>{p.category_pl}</span>
                    <h3><a href={`/projekty/${p.slug}/`} {...lmRow(p, 'title')}>{p.title_pl}</a></h3>
                    <p class="desc" data-lm-pl={tg.pl} data-lm-en={tg.en} data-lm-ru={tg.ru}>{tg.pl}</p>
                    <a class="feat-view" href={`/projekty/${p.slug}/`}><span data-i18n="home.projects.view">Zobacz projekt</span><svg viewBox="0 0 18 18" fill="none"><path d="M18 0v13.5h-1.5V2.5L1 18l-1-1L15.4 1.5H4.5V0z" fill="currentColor"/></svg></a>
                  </div>
                  {p.results.length > 0 && (
                    <ul class="feat-results">
                      {p.results.slice(0, 3).map((r) => <li><b>{r.value}</b><span {...lmRow(r, 'label')}>{r.label_pl}</span></li>)}
                    </ul>
                  )}
                </div>
              </article>
            ); })}
          </div>
        </div>
      </section>
      <div class="divider" aria-hidden="true"></div>

      <!-- ── PROCESS ──────────────────────────────────────────────────── -->
      <section class="sec" id="proces">
        <div class="sec-inner sec-pad">
          <div class="process">
            <div class="process-left">
              <span class="kicker" data-i18n="home.process.kicker">Proces</span>
              <h2 class="h-sec" data-i18n="home.process.title">Jasny plan od briefu do startu</h2>
              <p class="lead" data-i18n="home.process.p">Każdy etap ma konkretny efekt, który widzisz i akceptujesz.</p>
              <div>
                <a class="btn btn-dark with-icon" href="#contact">
                  <span class="btn-ico"><svg viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M13 3H6M13 3v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  <span data-i18n="home.process.cta">Zacznij projekt</span>
                </a>
              </div>
            </div>
            <div class="steps">
              {[1, 2, 3, 4].map((n) => (
                <div class="step" data-reveal>
                  <div class="step-media tile-pattern"><span class="tp-label">BarabashFlow</span><span class="tp-num">0{n}</span></div>
                  <div class="step-row">
                    <span class="step-num">//0{n}</span>
                    <div>
                      <h3 data-i18n={`process.${n}.t`}>{['Brief i wycena', 'Struktura i treści', 'Projekt i kod', 'Start i opieka'][n - 1]}</h3>
                      <p data-i18n={`process.${n}.p`}>{[
                        'Krótka rozmowa lub formularz. W 24 godziny dostajesz plan, zakres, harmonogram i cenę — bez zobowiązań.',
                        'Układamy strony i sekcje pod cel biznesowy, piszemy prawdziwe teksty i dobieramy zdjęcia. Tu decydujemy, co ma sprzedawać.',
                        'Projekt graficzny pod Twoją markę, potem szybki, statyczny kod. Postęp oglądasz na żywo na adresie testowym.',
                        'Wdrożenie na domenie, panel CMS, Search Console. Po starcie — monitoring, kopie i rozwój w abonamencie.',
                      ][n - 1]}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
      <div class="divider" aria-hidden="true"></div>

      <!-- ── MARQUEE ──────────────────────────────────────────────────── -->
      <section class="sec">
        <div class="sec-inner is-grey marquee" aria-hidden="true">
          <div class="marquee-row">
            {[1, 2].map(() => ['marquee.1', 'marquee.2', 'marquee.3'].map((k) => <span data-i18n={k}>{k}</span>))}
          </div>
          <div class="marquee-row is-rev">
            {[1, 2].map(() => ['marquee.4', 'marquee.5', 'marquee.6'].map((k) => <span data-i18n={k}>{k}</span>))}
          </div>
        </div>
      </section>
      <div class="divider" aria-hidden="true"></div>

      <!-- ── WHY ──────────────────────────────────────────────────────── -->
      <section class="sec">
        <div class="sec-inner sec-pad">
          <div class="sec-head is-center">
            <span class="kicker" data-i18n="home.why.kicker">Różnica</span>
            <h2 class="h-sec is-center" data-i18n="home.why.title">Dlaczego nie agencja i nie szablon</h2>
          </div>
          <div class="why-grid">
            <div class="why-card" data-reveal>
              <div class="head"><span data-i18n="why.left.h">Agencja lub szablon</span></div>
              <ul>
                {[1, 2, 3, 4, 5, 6].map((n) => <li><i><svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6.5 5 9l4.5-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></i><span data-i18n={`why.l.${n}`}>…</span></li>)}
              </ul>
            </div>
            <div class="why-card is-us" data-reveal data-reveal-delay="120">
              <div class="head"><img src="/assets/img/logo.png" alt="" width="22" height="27" style="display:inline-block;vertical-align:-6px;margin-right:8px" /><span style="color:var(--ink);font-weight:600" data-i18n="why.right.h">BarabashFlow</span><sup style="font-size:9px;color:var(--muted)">™</sup></div>
              <ul>
                {[1, 2, 3, 4, 5, 6].map((n) => <li><i><svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6.5 5 9l4.5-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></i><span data-i18n={`why.r.${n}`}>…</span></li>)}
              </ul>
            </div>
          </div>
          <div class="why-cta"><a class="btn btn-dark" href="#contact" data-i18n="home.why.cta">Porozmawiajmy</a></div>
        </div>
      </section>
      <div class="divider" aria-hidden="true"></div>

      <!-- ── BLOG ─────────────────────────────────────────────────────── -->
      {posts.length > 0 && (
        <>
          <section class="sec" id="blog">
            <div class="sec-inner is-grey sec-pad">
              <div class="sec-head is-split">
                <div>
                  <span class="kicker is-white" data-i18n="home.blog.kicker">Blog</span>
                  <h2 class="h-sec" style="margin-top:18px" data-i18n="home.blog.title">Ostatnio na blogu</h2>
                  <p class="lead" style="margin-top:14px" data-i18n="home.blog.sub">Praktyczne odpowiedzi na pytania, które klienci zadają przed zleceniem strony lub platformy.</p>
                </div>
                <a class="btn btn-white" href="/blog/" data-i18n="home.blog.all">Wszystkie wpisy</a>
              </div>
              <div class="blog-grid">
                {posts.map((p) => <BlogCard p={p} />)}
              </div>
            </div>
          </section>
          <div class="divider" aria-hidden="true"></div>
        </>
      )}

      <!-- ── FAQ ──────────────────────────────────────────────────────── -->
      {faq.length > 0 && (
        <section class="sec" id="faq">
          <div class="sec-inner sec-pad">
            <div class="sec-head is-center">
              <span class="kicker" data-i18n="home.faq.kicker">FAQ</span>
              <h2 class="h-sec is-center" data-i18n="home.faq.title">Częste pytania</h2>
            </div>
            <FaqList items={faq} />
          </div>
        </section>
      )}
    </div>
  </main>

  <SiteFooter services={services} settings={settings} />

  <script>
    import { mountShell } from '../lib/shell';
    import { mountLogo3D } from '../lib/logo3d';
    mountShell();
    // 3D mark after first paint — three.js is a separate lazy chunk.
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(() => mountLogo3D(), { timeout: 1200 });
    else setTimeout(() => mountLogo3D(), 300);
  </script>
</Base>
