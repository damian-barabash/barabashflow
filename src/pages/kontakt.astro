---
// Contact page: three fact cards + the light form card; the dark footer
// contact block is skipped here (the form IS the page).
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactForm from '../components/ContactForm.astro';
import { fetchSettings, fetchServices } from '../lib/content';
import { SITE, EMAIL, ORG_ID } from '../lib/site';

const [settings, services] = await Promise.all([fetchSettings(), fetchServices()]);
const title = 'Kontakt — wycena strony, sklepu lub platformy | BarabashFlow';
const description = 'Skontaktuj się z BarabashFlow: formularz, e-mail office@barabashflow.pl, Warszawa. Odpowiedź z planem i wyceną strony, sklepu lub platformy w ciągu 24 godzin.';
const contactLd = { '@context': 'https://schema.org', '@type': 'ContactPage', '@id': `${SITE}/kontakt/#contact`, url: `${SITE}/kontakt/`, name: title, description, inLanguage: 'pl', about: { '@id': ORG_ID } };
const crumbsLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'BarabashFlow', item: SITE + '/' },
  { '@type': 'ListItem', position: 2, name: 'Kontakt', item: SITE + '/kontakt/' },
] };
---
<Base title={title} description={description} jsonLd={[contactLd, crumbsLd]}>
  <SiteHeader active="contact" />
  <main class="container">
    <section class="sec">
      <div class="sec-inner page-head">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">BarabashFlow</a><span>/</span><span data-i18n="nav.contact">Kontakt</span></nav>
        <span class="kicker"><span class="status-dot" aria-hidden="true" style="margin-right:6px"></span><span data-i18n="meta.available">Dostępny</span></span>
        <h1 data-i18n="contact.page.title">Porozmawiajmy o Twoim projekcie</h1>
        <p class="lead" data-i18n="contact.page.lead">Opisz pomysł w kilku zdaniach — w ciągu 24 godzin odpiszę z planem, zakresem i wyceną. Strona, sklep, platforma czy panel: zaczynamy od rozmowy.</p>
      </div>
    </section>
    <div class="divider" aria-hidden="true"></div>
    <section class="sec" id="contact">
      <div class="sec-inner is-grey sec-pad">
        <dl class="contact-facts">
          <div class="fact">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18v12H3z"/><path d="m3 7 9 6 9-6"/></svg></span>
            <dt data-i18n="contact.page.email">E-mail</dt>
            <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
          </div>
          <div class="fact">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
            <dt data-i18n="contact.page.reply">Czas odpowiedzi</dt>
            <dd data-i18n="contact.page.reply.v">do 24 godzin w dni robocze</dd>
          </div>
          <div class="fact">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6-5.4-6-11a6 6 0 0 1 12 0c0 5.6-6 11-6 11z"/><circle cx="12" cy="10" r="2.2"/></svg></span>
            <dt data-i18n="contact.page.location">Lokalizacja</dt>
            <dd data-i18n="contact.page.location.v">Warszawa, Polska — zdalnie dla klientów z całego świata</dd>
          </div>
        </dl>
        <ContactForm source="kontakt-page" variant="light" id="cf-page" />
      </div>
    </section>
  </main>
  <SiteFooter services={services} settings={settings} contact={false} />
  <script>
    import { mountShell } from '../lib/shell';
    mountShell();
  </script>
</Base>
