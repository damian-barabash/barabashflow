---
// Sticky white header: brand | nav | lang + CTA. Burger under 1024px.
export interface Props {
  active?: 'home' | 'services' | 'projects' | 'blog' | 'about' | 'contact' | 'privacy' | 'none';
}
import { EMAIL } from '../lib/site';
const { active = 'none' } = Astro.props;
const items: { key: Props['active']; href: string; label: string; i18n: string }[] = [
  { key: 'home', href: '/', label: 'Strona główna', i18n: 'nav.home' },
  { key: 'services', href: '/uslugi/', label: 'Usługi', i18n: 'nav.services' },
  { key: 'projects', href: '/projekty/', label: 'Projekty', i18n: 'nav.projects' },
  { key: 'blog', href: '/blog/', label: 'Blog', i18n: 'nav.blog' },
  { key: 'about', href: '/o-mnie/', label: 'O mnie', i18n: 'nav.about' },
  { key: 'contact', href: '/kontakt/', label: 'Kontakt', i18n: 'nav.contact' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="BarabashFlow — strona główna">
      <img class="brand-logo" src="/assets/img/logo.png" alt="Logo BarabashFlow" width="24" height="30" draggable="false" />
      <span>barabashflow<span class="brand-tm">™</span></span>
    </a>
    <nav class="site-nav" aria-label="Nawigacja">
      {items.map((it, i) => (
        <a href={it.href} aria-current={active === it.key ? 'page' : undefined} style={`--i:${i}`}><span class="ni" aria-hidden="true">0{i + 1}</span><span class="nl" data-i18n={it.i18n}>{it.label}</span></a>
      ))}
      <div class="nav-extra" style={`--i:${items.length}`}>
        <a class="nav-mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a class="btn btn-lime" href="/kontakt/" data-i18n="nav.cta">Wycena projektu</a>
      </div>
    </nav>
    <div class="header-actions">
      <div class="lang-switch" aria-label="Język / Language"></div>
      <a class="btn btn-dark" href="/kontakt/" data-i18n="nav.cta">Wycena projektu</a>
      <button class="nav-burger" id="nav-burger" type="button" aria-label="Menu" aria-expanded="false">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path class="l1" d="M3 6.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path class="l2" d="M3 10h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path class="l3" d="M3 13.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</header>
