---
// Page tail on every public page: CTA band ("Zacznijmy Twój projekt"),
// availability bar, dark contact block with the enquiry form, footer links,
// big brand word and the copyright row. `contact=false` on /kontakt/ where
// the form is the page itself.
import ContactForm from './ContactForm.astro';
import { AUTHOR_NAME, EMAIL, SOCIAL } from '../lib/site';
import type { Service, Settings } from '../lib/content';
import { s, lm } from '../lib/content';
export interface Props { services?: Service[]; settings?: Settings; contact?: boolean; cta?: boolean }
const { services = [], settings = {}, contact = true, cta = true } = Astro.props;
const year = new Date().getFullYear();
const availability = s(settings, 'availability', 'pl', '');
---
<footer class="site-footer">
  {cta && (
    <div class="container">
      <section class="sec">
        <div class="cta-band">
          <div class="arrow-track is-left" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 4h3l6 8-6 8H6l6-8z"/></svg>
            <svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 4h3l6 8-6 8H6l6-8z"/></svg>
            <svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 4h3l6 8-6 8H6l6-8z"/></svg>
          </div>
          <div class="arrow-track is-right" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path fill="currentColor" d="M18 4h-3l-6 8 6 8h3l-6-8z"/></svg>
            <svg viewBox="0 0 24 24"><path fill="currentColor" d="M18 4h-3l-6 8 6 8h3l-6-8z"/></svg>
            <svg viewBox="0 0 24 24"><path fill="currentColor" d="M18 4h-3l-6 8 6 8h3l-6-8z"/></svg>
          </div>
          <h2 class="display"><span data-i18n="cta.band.a">Zacznijmy</span><br /><span data-i18n="cta.band.b">Twój projekt</span></h2>
          <a class="cta-mark" href="#contact" aria-label="Kontakt"><img src="/assets/img/logo.png" alt="" width="40" height="49" /></a>
          <div class="cta-steps" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
          <span class="kicker is-dark cta-tag is-left" data-i18n="cta.tag.left">Strony · Sklepy · Platformy</span>
          <span class="kicker is-dark cta-tag is-right" data-i18n="cta.tag.right">Warszawa · zdalnie · PL EN RU</span>
        </div>
        {availability && (
          <div class="avail-bar">
            <span aria-hidden="true">›››</span>
            <b {...lm(settings, 'availability')}>{availability}</b>
            <span aria-hidden="true">‹‹‹</span>
          </div>
        )}
      </section>
    </div>
  )}

  {contact && (
    <div class="container">
      <section class="sec" id="contact">
        <div class="contact-block">
          <div class="contact-info">
            <div class="row">
              <span class="kicker" data-i18n="contact.kicker">Kontakt</span>
              <div class="big">
                <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
                <small data-i18n="contact.hours">Odpowiadam w ciągu 24 godzin w dni robocze</small>
              </div>
            </div>
            <div class="row">
              <span class="kicker" data-i18n="contact.page.location">Lokalizacja</span>
              <div class="loc">
                <h3>Warszawa</h3>
                <p data-i18n="contact.page.location.v">Warszawa, Polska — zdalnie dla klientów z całego świata</p>
                <p>Polski · English · Русский</p>
              </div>
            </div>
          </div>
          <ContactForm source="footer" services={services} variant="dark" id="cf-footer" />
        </div>
      </section>
    </div>
  )}

  <div class="container">
    <div class="sec-inner">
      <nav class="footer-links" aria-label="Mapa strony">
        <a href="/uslugi/" data-i18n="nav.services">Usługi</a><i></i>
        <a href="/projekty/" data-i18n="nav.projects">Projekty</a><i></i>
        <a href="/blog/" data-i18n="nav.blog">Blog</a><i></i>
        <a href="/o-mnie/" data-i18n="nav.about">O mnie</a><i></i>
        <a href="/kontakt/" data-i18n="nav.contact">Kontakt</a>
      </nav>
      <div class="footer-brand">
        <div class="px is-tl" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <a class="word" href="/" aria-label="BarabashFlow"><img src="/assets/img/logo.png" alt="" width="326" height="402" />barabash<span style="font-weight:500">flow</span></a>
      </div>
      <div class="footer-bottom">
        <div class="social">
          {SOCIAL.map((so) => <a href={so.url} rel="me noopener" target="_blank">{so.label}</a>)}
          <a href={`mailto:${EMAIL}`}>E-mail</a>
          <a href="/blog/rss.xml">RSS</a>
          <a href="/polityka-prywatnosci/" data-i18n="nav.privacy">Polityka prywatności</a>
        </div>
        <p>© {year} {AUTHOR_NAME} · BarabashFlow · <span data-i18n="footer.rights">Wszelkie prawa zastrzeżone</span></p>
        <button class="scroll-top" type="button" data-scroll-top>
          <span data-i18n="footer.top">Do góry</span>
          <svg viewBox="0 0 16 16" fill="none"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>

  <aside class="cookie-notice" id="cookie-notice" aria-live="polite">
    <p data-i18n="cookie.text">Ta strona nie śledzi. W pamięci przeglądarki zapisuje tylko język i to, że zamknąłeś ten komunikat.</p>
    <div class="row">
      <button class="btn btn-dark" type="button" data-cookie-ok data-i18n="cookie.ok">Rozumiem</button>
      <a class="btn btn-white" href="/polityka-prywatnosci/" data-i18n="cookie.policy">Polityka</a>
    </div>
  </aside>
</footer>
