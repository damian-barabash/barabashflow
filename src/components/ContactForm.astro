---
// Enquiry form → contact_submissions (anon INSERT via RLS). `source` tells
// the admin inbox where the message came from. Same markup in the dark
// footer block and the light contact-page card (variant = styling only).
import type { Service } from '../lib/content';
export interface Props {
  source: string;
  services?: Service[];
  variant?: 'dark' | 'light';
  id?: string;
}
const { source, services = [], variant = 'dark', id = `cf-${source}` } = Astro.props;
const BUDGETS = ['do 5 000 zł', '5 000 – 10 000 zł', '10 000 – 25 000 zł', '25 000 – 50 000 zł', 'powyżej 50 000 zł'];
---
<form class={variant === 'light' ? 'form-card' : 'contact-form'} data-contact-form={source} id={id} autocomplete="on" novalidate>
  <div class="f-grid">
    <div class="f-field">
      <label for={`${id}-name`} data-i18n="contact.name">Imię i nazwisko</label>
      <input id={`${id}-name`} name="name" type="text" required maxlength="120" autocomplete="name" placeholder="Jan Kowalski" />
    </div>
    <div class="f-field">
      <label for={`${id}-email`} data-i18n="contact.email">E-mail</label>
      <input id={`${id}-email`} name="email" type="email" required maxlength="160" autocomplete="email" placeholder="jan@firma.pl" />
    </div>
    <div class="f-field">
      <label for={`${id}-phone`} data-i18n="contact.phone">Telefon (opcjonalnie)</label>
      <input id={`${id}-phone`} name="phone" type="tel" maxlength="40" autocomplete="tel" placeholder="+48 …" />
    </div>
    <div class="f-field">
      <label for={`${id}-company`} data-i18n="contact.company">Firma (opcjonalnie)</label>
      <input id={`${id}-company`} name="company" type="text" maxlength="120" autocomplete="organization" />
    </div>
    <div class="f-field">
      <label for={`${id}-service`} data-i18n="contact.service">Czego potrzebujesz?</label>
      <select id={`${id}-service`} name="service">
        <option value="" data-i18n="contact.service.any">Nie wiem jeszcze — doradź</option>
        {services.map((s) => <option value={s.slug} data-lm-pl={s.title_pl} data-lm-en={s.title_en || s.title_pl} data-lm-ru={s.title_ru || s.title_pl}>{s.title_pl}</option>)}
      </select>
    </div>
    <div class="f-field">
      <label for={`${id}-budget`} data-i18n="contact.budget">Orientacyjny budżet</label>
      <select id={`${id}-budget`} name="budget">
        <option value="" data-i18n="contact.budget.any">Do ustalenia</option>
        {BUDGETS.map((b) => <option value={b}>{b}</option>)}
      </select>
    </div>
    <div class="f-field is-full">
      <label for={`${id}-msg`} data-i18n="contact.message">Opisz projekt</label>
      <textarea id={`${id}-msg`} name="message" required maxlength="4000" rows="4" data-i18n-placeholder="contact.message.ph" placeholder="Kilka zdań: co robi Twoja firma, co ma robić strona, kiedy chcesz wystartować."></textarea>
    </div>
    <label class="f-hp" aria-hidden="true">Strona www<input type="text" name="website_url" tabindex="-1" autocomplete="off" /></label>
  </div>
  <div class="form-status" aria-live="polite"></div>
  <button type="submit" class={`btn ${variant === 'light' ? 'btn-dark' : 'btn-dark'} is-block`} data-i18n="contact.submit">Wyślij zapytanie</button>
  <p class="form-consent"><span data-i18n="contact.consent">Wysyłając wiadomość, akceptujesz politykę prywatności.</span> <a href="/polityka-prywatnosci/" data-i18n="nav.privacy">Polityka prywatności</a></p>
</form>
